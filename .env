COMPOSE_PROJECT_NAME=temporal
CASSANDRA_VERSION=3.11.9
ELASTICSEARCH_VERSION=7.17.27
MYSQL_VERSION=8
TEMPORAL_VERSION=1.29.1
TEMPORAL_ADMINTOOLS_VERSION=1.29.1-tctl-1.18.4-cli-1.5.0
TEMPORAL_UI_VERSION=2.34.0
POSTGRESQL_VERSION=16
POSTGRES_PASSWORD=temporal
POSTGRES_USER=temporal
POSTGRES_DEFAULT_PORT=5432
OPENSEARCH_VERSION=2.5.0
REDIS_VERSION=7-alpine

# -----------------------------------------------------------------------------
# Registry control-plane dataplane config
# -----------------------------------------------------------------------------
# valid: local | orchestrator | s3 | cloudinary
REGISTRY_DATAPLANE_MODE=cloudinary

# orchestrator mode
REGISTRY_DATAPLANE_ORCHESTRATOR_BASE_URL=
REGISTRY_DATAPLANE_ORCHESTRATOR_TOKEN=

# s3 mode
REGISTRY_DATAPLANE_S3_BUCKET=
REGISTRY_DATAPLANE_S3_REGION=
REGISTRY_DATAPLANE_S3_PREFIX=
REGISTRY_DATAPLANE_S3_ACCESS_KEY=
REGISTRY_DATAPLANE_S3_SECRET_KEY=

# cloudinary mode
REGISTRY_DATAPLANE_CLOUDINARY_CLOUD_NAME=dqgclphiu
REGISTRY_DATAPLANE_CLOUDINARY_API_KEY=843823632515638
REGISTRY_DATAPLANE_CLOUDINARY_API_SECRET=b-hDVU9Nj9GfVH6-7ZvzZ7SpQT4
REGISTRY_DATAPLANE_CLOUDINARY_FOLDER=

# -----------------------------------------------------------------------------
# Worker control-plane auth (set per Comfy worker / graviton_bridge)
# -----------------------------------------------------------------------------
# Must match the generated worker control secret for that worker.
GRAVITON_BRIDGE_CONTROL_HMAC_SECRET=

# optional hardening/tuning
GRAVITON_BRIDGE_CONTROL_MAX_SKEW_SECONDS=60
GRAVITON_BRIDGE_CONTROL_NONCE_TTL_SECONDS=300
