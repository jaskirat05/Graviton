# ComfyAutomate Configuration
# ============================

storage:
  artifacts_dir: ./artifacts

# =============================================================================
# ComfyUI Servers
# =============================================================================

servers:
  # ===========================================================================
  # LOCAL COMFYUI (same machine as Graviton)
  # ===========================================================================

  # Windows / Mac (Docker Desktop)
  - name: local
    provider: comfyui
    address: host.docker.internal
    port: 8188

  # Linux (Docker) - same as above, extra_hosts already in docker-compose.yml
  # - name: local
  #   provider: comfyui
  #   address: host.docker.internal
  #   port: 8188

  # ===========================================================================
  # REMOTE COMFYUI (expose over internet)
  # ===========================================================================

  # --- Cloudflare Tunnel (recommended - free, no account required) ---
  # On remote machine run:
  #   cloudflared tunnel --url http://localhost:8188
  # Then copy the URL it gives you
  #
  # - name: cloud-gpu
  #   provider: comfyui
  #   address: random-name.trycloudflare.com
  #   port: 443
  #   ssl: true

  # --- ngrok ---
  # On remote machine run:
  #   ngrok http 8188
  # Then copy the forwarding URL
  #
  # - name: ngrok-worker
  #   provider: comfyui
  #   address: abc123.ngrok.io
  #   port: 443
  #   ssl: true
